{
  "expo": {
    "name": "PRESIDENTKU",
    "slug": "presidentku-location",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0d1b3e"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Aplikasi PresidentKu membutuhkan izin lokasi untuk menampilkan koordinat dan posisi pada peta."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d1b3e"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    }
  }
}
